<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is refused by default since Android 9, and that default is kept.

  MARK LIII's dashboard serves plain HTTP on port 8000 unless config/certs/ is
  populated, so the connection has to be protected by the transport underneath
  it. That transport is Tailscale: WireGuard encrypts everything between the
  phone and the VPS, and the tailnet is not reachable from the internet at all.

  That is not a detail — it is the ONLY thing protecting the audio. MARK LIII's
  AES-256-CBC layer (dashboard/server.py) covers *text commands* and nothing
  else: /ws/phone-audio and /ws/phone-out carry raw PCM with no application-
  level encryption. Speaking to JARVIS over plain HTTP on an untrusted network
  means speaking in the clear.

  So cleartext is opened for exactly one place: Tailscale MagicDNS names, which
  only resolve inside the tailnet.

    ✔  ws://jarvis.tailnet-1234.ts.net:8000/ws/phone-audio
    ✘  ws://203.0.113.10:8000/...            (public IP — refused, correctly)

  Using a bare 100.x.y.z Tailscale address instead of a MagicDNS name?
  network-security-config matches hosts, not CIDR ranges, so add that exact
  address as another <domain> below. The debug build already allows everything
  (src/debug/res/xml/network_security_config.xml) so a first test on the LAN
  needs no edit here at all.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
