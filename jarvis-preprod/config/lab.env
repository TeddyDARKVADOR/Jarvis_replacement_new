# jarvis-preprod — la seule source de configuration du laboratoire.
#
# Sourcé par tous les scripts. Rien d'autre ne doit coder un chemin, un port ou
# un numéro de série en dur : quand une valeur change, elle change ici.
#
# Toutes les valeurs sont surchargeables par l'environnement, ce qui permet de
# lancer une campagne sur un second AVD sans éditer ce fichier :
#
#     LAB_AVD=jarvis_lab2 LAB_SERIAL=emulator-5556 ./preprod smoke

# ── cible ADB ────────────────────────────────────────────────────────────────
#
# LAB_SERIAL est le seul appareil que le laboratoire a le droit de toucher, et
# tools/adb.sh refuse tout ce qui ne correspond pas au motif emulator-*. Le
# Redmi réel ne doit JAMAIS être atteignable depuis ici : une commande de test
# qui part sur le téléphone de quelqu'un est une désinstallation, un force-stop
# ou un wipe sur un appareil qui sert tous les jours.
: "${LAB_AVD:=jarvis_lab}"
: "${LAB_SERIAL:=emulator-5554}"
: "${LAB_EMULATOR_PORT:=5554}"

# ── application ──────────────────────────────────────────────────────────────
: "${LAB_PACKAGE:=com.jarvis}"
: "${LAB_ACTIVITY:=com.jarvis.MainActivity}"
: "${LAB_SERVICE:=com.jarvis.service.JarvisForegroundService}"

# ── serveur MARK LIII local ──────────────────────────────────────────────────
#
# 10.0.2.2 est l'alias que l'émulateur donne au loopback de l'hôte : depuis
# l'AVD, 127.0.0.1 désigne l'AVD lui-même. C'est l'adresse à saisir dans
# l'application, jamais l'IP LAN du PC.
: "${LAB_SERVER_PORT:=8000}"
: "${LAB_SERVER_HOST_FROM_EMULATOR:=10.0.2.2}"
: "${LAB_SERVER_HOST_FROM_PC:=127.0.0.1}"

# ── chaîne d'outils ──────────────────────────────────────────────────────────
: "${LAB_SDK:=C:/Users/Ats-grtyu/AppData/Local/Android/Sdk}"
: "${LAB_JDK:=D:/DEV/android-toolchain/jdk-21}"
: "${LAB_AVD_HOME:=D:/DEV/android-toolchain/avd}"

# ── délais ───────────────────────────────────────────────────────────────────
#
# Généreux à dessein : un émulateur qui démarre à froid sur un disque occupé
# met plusieurs minutes, et un test qui abandonne trop tôt produit un FAIL qui
# ne veut rien dire.
: "${LAB_BOOT_TIMEOUT:=300}"
: "${LAB_UI_TIMEOUT:=30}"
: "${LAB_CONNECT_TIMEOUT:=60}"

export LAB_AVD LAB_SERIAL LAB_EMULATOR_PORT
export LAB_PACKAGE LAB_ACTIVITY LAB_SERVICE
export LAB_SERVER_PORT LAB_SERVER_HOST_FROM_EMULATOR LAB_SERVER_HOST_FROM_PC
export LAB_SDK LAB_JDK LAB_AVD_HOME
export LAB_BOOT_TIMEOUT LAB_UI_TIMEOUT LAB_CONNECT_TIMEOUT
